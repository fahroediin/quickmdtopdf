# Supabase Connection
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only (never prefix with PUBLIC_). Used to write PDF usage logs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Administrator Emails (single email or comma-separated list of emails)
PUBLIC_ADMIN_EMAIL=admin@yourdomain.com,owner@yourdomain.com

# Optional: Server Port & Host for Node Deployment
PORT=5173
HOST=0.0.0.0
